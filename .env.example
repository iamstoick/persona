# Node
NODE_ENV=development
PORT=4000

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gv_db
POSTGRES_USER=gv_user
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=changeme_32chars_minimum_here____
JWT_REFRESH_SECRET=changeme_32chars_minimum_here_r__
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend (used for CORS + OAuth redirect)
FRONTEND_URL=http://localhost:8899

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Email (Nodemailer — use Mailtrap for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_TO=gerald@geraldvillorente.com

# Next.js public vars (browser-facing)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:8899

# Server-side API address, as seen from the Next.js server process itself.
# In Docker this must be the api service's container-network name (http://api:4000),
# not localhost — set by docker-compose.yml already. Only needed outside Docker if
# the API runs somewhere other than localhost:4000.
API_INTERNAL_URL=
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Media (S3-compatible for production)
MEDIA_STORAGE=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
